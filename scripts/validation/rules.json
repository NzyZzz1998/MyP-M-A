{
  "schema_version": 1,
  "skill_char_budget": 5700,
  "stage_core_budget": 600,
  "allowed_frontmatter_keys": ["name", "description", "license", "allowed-tools", "metadata"],
  "required_loading_routes": {
    "review": ["references/review.md", "references/code-review-scanner.md"],
    "idea": ["references/idea.md"],
    "prd": ["references/prd.md"],
    "acceptance": ["references/acceptance.md", "references/tooling.md"],
    "prompt": ["references/prompt.md", "references/workflow-control.md"]
  },
  "required_quality_files": [
    "evals/README.md",
    "scripts/regression-workspace.ps1",
    "capabilities/README.md",
    "capabilities/registry.json",
    "evals/external-candidates.json",
    "evals/external-benchmark.json",
    "evals/external-benchmark-contract.json",
    "evals/release-quality-policy.json",
    "examples/public-case-spec.md",
    "examples/case-manifest.schema.json",
    "examples/index.json"
  ],
  "required_evaluation_scripts": [
    "scripts/regression-workspace.ps1",
    "scripts/grading-batches.ps1",
    "scripts/delivery-quality-batches.ps1",
    "scripts/test-evaluation-pipeline.ps1",
    "scripts/test-delivery-quality.ps1",
    "scripts/generate-eval-viewer.ps1",
    "scripts/build-eval-panel.ps1",
    "scripts/test-skill-validation.ps1",
    "scripts/test-v036-governance.ps1",
    "scripts/test-v037-fact-fidelity.ps1",
    "scripts/test-v038-evidence-action-adapters.ps1",
    "scripts/test-v039-reliable-delivery.ps1",
    "scripts/validation/validate-capabilities.ps1",
    "scripts/validation/validate-external-benchmark.ps1",
    "scripts/validation/validate-public-cases.ps1"
  ],
  "runtime_terms": {
    "memory": ["memory_mode", "auto", "suggest", "off", "memory-continue", "memory-notes", "memory-capture"],
    "memory_evidence": ["unavailable", "not-found", "memory-only", "verified-source"],
    "prompt": ["/prompt", "next", "continue", "bugfix", "acceptance", "release", "handoff", "commit", "push", "tag", "Release"],
    "prompt_compression": ["L1", "L2", "L3", "300-600", "500-900", "800-1500"],
    "official_prompt_guidance": ["zero-shot", "preserve-first", "trim-first", "tool-orchestration", "retry-limit", "stop-condition"]
  }
}
